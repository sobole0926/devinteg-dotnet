<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DevInteg.DropboxSign</PackageId>
    <Description>A thin Dropbox Sign client for embedded signing over plain HTTP, no vendor SDK: create a request, find it by metadata, fresh sign URLs, status, cancel, download, verified callbacks, and signed signing-link tokens with a rotating key ring.</Description>
    <PackageTags>dropbox-sign;hellosign;e-signature;embedded-signing;webhooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <MinVerTagPrefix>dropboxsign/v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <!-- Breaking changes are caught against the last release once 1.0.0 ships: set PackageValidationBaselineVersion. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="DevInteg.DropboxSign.Tests" />
  </ItemGroup>
</Project>
